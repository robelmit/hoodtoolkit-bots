# Settings for docker-compose.yml. Copy to .env and fill in; .env is never committed.

# Your Robinhood Chain endpoint. Empty uses the public one, which rate-limits.
HOOD_RPC_URL=

# A fixed price so trades paid in ETH have a dollar value, for example {"ETH":3000}. See packages/feed/README.md.
QUOTE_PRICES_JSON=

# Telegram bot (docker compose --profile telegram up -d)
TELEGRAM_BOT_TOKEN=

# Discord bot (docker compose --profile discord up -d)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_MESSAGE_CONTENT=0

# Buttons under cards and buy posts: Label|https://…{address}, comma separated. Empty keeps the explorer button.
BOT_BUTTONS=
